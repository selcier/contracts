# Signs the deployment. This account owns the factory and, unless overridden below, collects fees and acts as verifier.
PRIVATE_KEY=

# Network access. Public URLs are throttled, so a single deploy is about all they suit. For anything more, use a
# provider such as Alchemy.
#   testnet: https://rpc.testnet.chain.robinhood.com  (chain id 46630)
#   mainnet: https://rpc.mainnet.chain.robinhood.com  (chain id 4663)
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC=

# Source verification on Blockscout
ROBINHOOD_TESTNET_BLOCKSCOUT_API=https://explorer.testnet.chain.robinhood.com/api
ROBINHOOD_BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api
BLOCKSCOUT_API_KEY=unused

# Payment token for raises, windows, quotes and payouts. Mainnet needs a real address. On any other network, an empty
# value deploys a 6-decimal test token.
USDG=

# Each of these falls back to the deployer when empty
FEE_RECIPIENT=
DEFAULT_VERIFIER=

# Creates the sample issuer, Larkway Labs. Defaults to false on mainnet and true everywhere else
DEPLOY_DEMO=true
